# Base URL of the backend, including the API version prefix.
# Must share a registrable domain with this app in production (app.example.com +
# api.example.com): the session cookie is SameSite=Lax.
VITE_API_BASE_URL=http://localhost:1010/api/v1
# local | development | staging | production
VITE_APP_ENV=local
# Optional: post Web Vitals here (leave empty to keep measurements on the device)
VITE_VITALS_URL=
# Optional, dev server only: proxy /api to a remote backend so its session cookie
# works on localhost. Pair with VITE_API_BASE_URL=http://localhost:9090/api/v1.
API_PROXY_TARGET=
