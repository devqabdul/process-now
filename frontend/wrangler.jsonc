{
  "name": "process-now",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.ts",
  "vars": { "API_ORIGIN": "https://process-now.onrender.com" },
  "assets": {
    "directory": "./build",
    "not_found_handling": "single-page-application",
    // Only /api reaches the Worker; every other path is a static asset.
    "run_worker_first": ["/api/*"],
  },
}
