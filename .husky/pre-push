#!/usr/bin/env sh

echo "🔎 Running type check..."
yarn --cwd frontend typecheck || { echo "❌ Frontend type check failed. Push aborted."; exit 1; }
yarn --cwd backend typecheck || { echo "❌ Backend type check failed. Push aborted."; exit 1; }

echo "🧪 Running tests..."
yarn --cwd frontend test || { echo "❌ Frontend tests failed. Push aborted."; exit 1; }
# Unit tests only: `test:e2e` needs a live DATABASE_URL.
yarn --cwd backend test || { echo "❌ Backend tests failed. Push aborted."; exit 1; }

echo "🏗️  Running build..."
yarn --cwd frontend build || { echo "❌ Frontend build failed. Push aborted."; exit 1; }
yarn --cwd backend build || { echo "❌ Backend build failed. Push aborted."; exit 1; }

echo "✅ All pre-push checks passed."
