#!/usr/bin/env sh

# ── Gitleaks: scan staged changes for secrets ──
if command -v gitleaks > /dev/null 2>&1; then
  echo "🔐 Running gitleaks..."
  if ! gitleaks protect --staged --verbose; then
    echo "❌ gitleaks detected secrets in staged files. Commit aborted."
    exit 1
  fi
else
  echo "⚠️  gitleaks not found. Install: brew install gitleaks — skipping secrets scan."
fi

# ── Semgrep: static analysis on staged TS/TSX, both apps ──
# Paths from `git diff` are repo-root-relative, so semgrep runs from the repo root with the
# rulesets given here — running it from an app directory would resolve them one level too deep.
if command -v semgrep > /dev/null 2>&1; then
  STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.ts' '*.tsx')
  if [ -n "$STAGED_FILES" ]; then
    echo "🔍 Running semgrep..."
    if ! printf '%s\n' "$STAGED_FILES" |
      xargs semgrep scan --config p/typescript --config p/react --config p/secrets --error --quiet; then
      echo "❌ semgrep found issues. Commit aborted."
      exit 1
    fi
  fi
else
  echo "⚠️  semgrep not found. Install: pip install semgrep — skipping static analysis."
fi

# ── Lint-staged: eslint + prettier on staged files ──
echo "✨ Running lint-staged..."
yarn lint-staged
