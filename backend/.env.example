# Supabase → Connect → Session pooler (port 5432), used by the app and the Prisma CLI.
# Keep ?sslmode=require: node-postgres does NOT use TLS unless the URL asks for it.
# URL-encode any of : / ? # [ ] @ in the password.
# postgresql://postgres.<project-ref>:<password>@<host>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# 32+ characters; `openssl rand -base64 48`
JWT_SECRET=
# frontend origin(s), for CORS; comma-separate several. Must share a registrable domain with this API
# (app.example.com + api.example.com), because the session cookie is SameSite=Lax.
WEB_ORIGIN=http://localhost:9090
PORT=1010
# development | test | production. Required: 'production' is what turns on the
# Secure cookie flag and turns off the Swagger docs.
NODE_ENV=development
# Proxy hops in front of the app (Express `trust proxy`). 0 when reached directly,
# 1 behind a single load balancer. Wrong value = one shared rate-limit bucket.
TRUST_PROXY=0
# Postgres connections per instance; divide the database's limit by replica count.
DB_POOL_MAX=10
# Failed logins allowed per IP per minute. Lower is safer, but everyone behind one
# office NAT shares the bucket.
LOGIN_RATE_LIMIT=5
# only for `yarn prisma db seed`: password given to every seeded user
SEED_PASSWORD=
